<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background: a soft pastel wash matching the app's seed colour (#F2B8D4).
  Flat rather than gradient-heavy so the spider reads clearly at launcher size, and so the
  themed-icon and monochrome variants stay legible.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFF8DCEA" />
                <item android:offset="1.0" android:color="#FFE7BBDA" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
